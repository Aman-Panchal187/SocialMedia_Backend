PORT=5000
NODE_ENV=development

# Postgres connection. DATABASE_URL takes precedence over the discrete PG* vars if set.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/photosphere
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/photosphere_test
PGHOST=localhost
PGPORT=5432
PGDATABASE=photosphere
PGUSER=postgres
PGPASSWORD=postgres

# Set to true when the database is a managed provider that requires SSL
# (Neon, Supabase, ElephantSQL, etc.) — leave false for local Postgres.
DB_SSL=false

JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email delivery — Brevo's HTTP API (plain HTTPS). Get an API key from
# Brevo's dashboard (Settings > SMTP & API > API Keys) and a verified sender
# email (Senders, Domains & Dedicated IPs > Senders). Both are required —
# sendEmail() throws if either is missing.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

COOKIE_SECRET=change_this_cookie_secret

# Optional — without it, POST /ai/caption-suggestion always returns { suggestion: null }
# rather than failing, since AI captioning is best-effort and never blocks post creation.
HUGGINGFACE_API_KEY=

# TURN relay for WebRTC calls (free tier at https://dashboard.metered.ca).
# Without it, calls only connect when both users' networks allow a direct
# peer-to-peer route — across different ISPs/mobile networks they won't.
# TURN_URLS is comma-separated.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
